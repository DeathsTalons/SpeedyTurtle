# Copy to .env.local and fill in. Never commit the real file.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# developer.kroger.com → My Apps → Create App (scope: product.compact)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Your Kroger store's locationId (we'll look it up together)
KROGER_LOCATION_ID=

# Stripe → Developers → API keys (start with test keys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks (or `stripe listen` locally); see README
STRIPE_WEBHOOK_SECRET=

# Optional: Meijer's public search key (the app has a built-in default)
MEIJER_SEARCH_KEY=
